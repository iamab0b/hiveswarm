{
  "name": "hiveswarm-desktop",
  "productName": "Hiveswarm",
  "version": "0.1.0",
  "description": "Hiveswarm as a desktop app: starts the engine (in WSL2 on Windows, locally on Linux and macOS) and shows the swarm in its own window.",
  "license": "MIT",
  "author": "Sahil Mehta",
  "homepage": "https://github.com/iamab0b/hiveswarm",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "engine": "cd .. && python3 -m build --wheel --outdir dist",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dev.hiveswarm.desktop",
    "productName": "Hiveswarm",
    "artifactName": "Hiveswarm-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "engine",
        "filter": [
          "*.whl"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hiveswarm"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "synopsis": "Control plane for swarms of coding agents"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamab0b/hiveswarm.git"
  }
}
